{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sample-tauri-desktop",
  "version": "0.1.0",
  "identifier": "com.desktopspec.sampletauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sample Tauri Desktop",
        "width": 1024,
        "height": 680,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}
