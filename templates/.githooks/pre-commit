#!/usr/bin/env bash
# ==============================================================================
# desktop-spec - Pre-commit Hook (Integridad Documental & Anti-Fantasmas)
# ==============================================================================

# DESKTOP-SPEC:START
echo "[desktop-spec] Validando integridad de especificaciones y trazabilidad del commit (--staged)..."

# 1. Resolver como invocar desktop-spec de forma portable
if command -v desktop-spec >/dev/null 2>&1; then
    desktop-spec check --staged
    CHECK_STATUS=$?
elif command -v dspec >/dev/null 2>&1; then
    dspec check --staged
    CHECK_STATUS=$?
elif [ -f "./cli/main.py" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 ./cli/main.py check --staged
    else
        python ./cli/main.py check --staged
    fi
    CHECK_STATUS=$?
elif command -v uvx >/dev/null 2>&1; then
    uvx desktop-spec check --staged
    CHECK_STATUS=$?
else
    echo ""
    echo "[ERROR] [desktop-spec] No se encontro el comando 'desktop-spec' ni 'dspec' en PATH."
    echo "   Instalalo globalmente con: uv tool install desktop-spec (o pipx install desktop-spec)"
    echo "   En caso de emergencia operativa, puedes omitir este hook con: git commit --no-verify"
    echo ""
    exit 1
fi

if [ $CHECK_STATUS -ne 0 ]; then
    echo ""
    echo "[ERROR] [desktop-spec] Commit bloqueado por verificacion de integridad o trazabilidad."
    echo "   - Si hay enlaces o esquemas rotos en docs/, corrigelos o ejecuta 'dspec sync'."
    echo "   - Si modificaste codigo fuente sin trazabilidad, registra primero el requerimiento en"
    echo "     docs/backlog/pending.md (ej. 'dspec req:new \"Fix...\" --impact PATCH')."
    echo "   - Escape solo para emergencias operativas: git commit --no-verify"
    echo ""
    exit 1
fi

echo "[OK] [desktop-spec] Validacion y trazabilidad superadas con exito."
# DESKTOP-SPEC:END
exit 0
